// Verilog code
// Chip 7458

module top_module ( 
    input p1a, p1b, p1c, p1d, p1e, p1f,
    output p1y,
    input p2a, p2b, p2c, p2d,
    output p2y );

    wire x, y;
    wire z, z1;
    
    assign p1y = x | y;
    assign x = p1a & p1b & p1c;
    assign y = p1d & p1e & p1f;
    
    assign p2y = z1 | z;
    assign z1 = p2a & p2b;
    assign z = p2c & p2d;
    

endmodule
