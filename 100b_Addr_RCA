module top_module( 
    input [99:0] a, b,
    input cin,
    output [99:0] cout,
    output [99:0] sum );

    genvar i;
	generate 
        for(i=0; i<100; i=i+1) begin : gen_add
            wire c_in;
            assign c_in = (i == 0) ? cin : cout[i-1];

                f_add unit (
                    .a(a[i]),
                    .b(b[i]),
                    .cin(c_in),
                    .cout(cout[i]),
                    .sum(sum[i])
                );
        end
    endgenerate
   
    
endmodule

module f_add ( // full adder
    input a, b, cin,
    output cout, sum );

    assign cout = (a & b) | (b & cin)  | (cin & a) ;
    assign sum = a ^ b ^ cin;
    // assign {carry,sum} = a+b+cin;
endmodule
